# Optional Twitch Helix configuration. Demo mode works without these values.
TWITCH_CLIENT_ID=
TWITCH_ACCESS_TOKEN=

# Optional local relay process environment (export before starting Node).
HLS_FILTER_ENABLED=false
HLS_FILTER_CONFIDENCE=0.90
HLS_FILTER_LOG=off
HLS_FILTER_FALLBACK=last-good
HLS_FILTER_DEBUG_SEQUENCE=
